{
  "name": "deepcoder",
  "version": "0.1.0",
  "description": "A small, model-agnostic agentic coding CLI. First provider: DeepSeek (OpenAI-compatible).",
  "type": "module",
  "exports": {
    ".": "./dist/sdk/index.js",
    "./server": "./dist/server/index.js"
  },
  "bin": {
    "deepcoder": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/*.test.ts\"",
    "test:adversarial": "node --import tsx --test \"test/adversarial/**/*.test.ts\"",
    "test:phase": "npm run typecheck && npm run test:unit && npm run test:adversarial",
    "test:live": "node --import tsx src/cli/main.ts --mode readonly \"list the files in src and summarize the project\"",
    "eval": "node evals/run.mjs",
    "eval:selftest": "node evals/run.mjs --selftest",
    "eval:local": "node --import tsx evals/local-bench/run.ts",
    "eval:local:selftest": "node --import tsx evals/local-bench/run.ts --selftest",
    "eval:local:report": "node --import tsx evals/local-bench/report.ts",
    "sandbox:smoke": "node --import tsx scripts/sandbox-smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
