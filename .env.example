# DeepSeek (the default and only provider) — copy to .env and fill in.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: heavier model used by /plan (reasoner planning mode).
# DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# --- Provider selection -----------------------------------------------------
# deepcoder is DeepSeek-only. The generic DEEPCODER_* vars below take precedence
# over the DEEPSEEK_* aliases above and are useful for delegating to a worker
# (see docs/delegation-workflow.md) without disturbing your interactive .env.
# DEEPCODER_PROVIDER=deepseek            # deepseek | openai-compatible
# DEEPCODER_API_KEY=
# DEEPCODER_BASE_URL=                     # required for openai-compatible
# DEEPCODER_MODEL=
#
# openai-compatible is an escape hatch for pointing at a local/proxy/self-hosted
# DeepSeek endpoint (same OpenAI-compatible engine). It resolves its key/base URL
# from the OPENAI_* prefix unless overridden by DEEPCODER_*:
#   DEEPCODER_PROVIDER=openai-compatible
#   DEEPCODER_BASE_URL=https://your-gateway/v1
#   DEEPCODER_API_KEY=...
#   DEEPCODER_MODEL=deepseek-v4-flash

# Optional overrides
# DEEPCODER_MAX_TURNS=20
# DEEPCODER_APPROVAL_MODE=ask          # ask | auto | readonly
# DEEPCODER_CONTEXT_BUDGET_TOKENS=64000 # approx tokens before history compaction
# DEEPCODER_COMPACT_AT=0.8             # compact when usage exceeds this fraction
# DEEPCODER_CHECKPOINTS=off            # off | manual | auto — local undo for agent edits (not git)
# DEEPCODER_SUBAGENT_MODEL=            # model for read-only /review subagents (defaults to the main model)
