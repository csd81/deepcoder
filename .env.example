# DeepSeek (OpenAI-compatible) — copy to .env and fill in.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: a heavier model for planning. Not used by the core loop yet.
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Optional overrides
# DEEPCODER_MAX_TURNS=20
# DEEPCODER_APPROVAL_MODE=ask   # ask | auto | readonly
