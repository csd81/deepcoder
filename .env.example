# DeepSeek (the default provider) — copy to .env and fill in.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: heavier model used by /plan (reasoner planning mode).
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# --- Provider selection (Phase 4B) -----------------------------------------
# Pick a backend. Default is deepseek. The generic DEEPCODER_* vars below take
# precedence over the DEEPSEEK_* aliases above.
# DEEPCODER_PROVIDER=deepseek            # deepseek | openai-compatible | ollama | qwen | anthropic
# DEEPCODER_API_KEY=                      # required (except ollama)
# DEEPCODER_BASE_URL=                     # required for openai-compatible
# DEEPCODER_MODEL=
#
# Anthropic (native Claude) example:
#   DEEPCODER_PROVIDER=anthropic
#   DEEPCODER_API_KEY=sk-ant-...
#   DEEPCODER_MODEL=claude-3-5-sonnet-latest
#
# Qwen (Alibaba DashScope) example:
#   DEEPCODER_PROVIDER=qwen
#   DEEPCODER_API_KEY=...
#   DEEPCODER_MODEL=qwen2.5-coder-32b-instruct
#
# Local Ollama example (no key needed):
#   DEEPCODER_PROVIDER=ollama
#   DEEPCODER_MODEL=llama3.1
#   # DEEPCODER_BASE_URL defaults to http://localhost:11434/v1
#
# Generic OpenAI-compatible gateway example:
#   DEEPCODER_PROVIDER=openai-compatible
#   DEEPCODER_BASE_URL=https://your-gateway/v1
#   DEEPCODER_API_KEY=...
#   DEEPCODER_MODEL=gpt-4o-mini

# Optional overrides
# DEEPCODER_MAX_TURNS=20
# DEEPCODER_APPROVAL_MODE=ask          # ask | auto | readonly
# DEEPCODER_CONTEXT_BUDGET_TOKENS=64000 # approx tokens before history compaction
# DEEPCODER_COMPACT_AT=0.8             # compact when usage exceeds this fraction
# DEEPCODER_CHECKPOINTS=off            # off | manual | auto — local undo for agent edits (not git)
# DEEPCODER_SUBAGENT_MODEL=            # model for read-only /review subagents (defaults to the main model)
