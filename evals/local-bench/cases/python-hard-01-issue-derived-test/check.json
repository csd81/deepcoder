{
  "name": "unit",
  "command": "python -m pytest -q",
  "timeoutMs": 60000,
  "solveAttempts": 3,
  "category": "issue-derived-test",
  "difficulty": "hard",
  "issueHintsLevel": "realistic",
  "forbiddenPatterns": [
    "\\bassert\\b"
  ],
  "requiredPatterns": [
    "raise ValueError"
  ],
  "allowedPaths": [
    "blueprints.py",
    "tests/"
  ],
  "expectedChangedPaths": [
    "blueprints.py"
  ],
  "requiredTestPaths": [
    "tests/"
  ]
}
